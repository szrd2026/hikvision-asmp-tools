* text=auto

# Windows launchers and PowerShell scripts must keep CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation and data files
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.png binary
*.zip binary
*.dll binary
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.command text eol=lf
